# ================================================
# MALTA SaaS — variáveis de ambiente (Supabase próprio)
# Este arquivo NÃO vai para o git (*.local está no .gitignore)
# ================================================

# --- Público (vai para o browser) ---
VITE_SUPABASE_URL="COLE_O_VALOR_AQUI"
VITE_SUPABASE_PUBLISHABLE_KEY="COLE_O_VALOR_AQUI"
VITE_SUPABASE_PROJECT_ID="COLE_O_VALOR_AQUI"

# --- Servidor (NUNCA vai para o browser) ---
SUPABASE_URL="COLE_O_VALOR_AQUI"
SUPABASE_PUBLISHABLE_KEY="COLE_O_VALOR_AQUI"
SUPABASE_PROJECT_ID="COLE_O_VALOR_AQUI"
SB_SERVICE_ROLE_KEY="COLE_O_VALOR_AQUI"

# --- Bot do Discord (NUNCA vai para o browser) ---
# URL da API REST do bot hospedado no Discloud (ex: https://meu-bot.discloud.app)
DISCORD_BOT_API_URL="COLE_O_VALOR_AQUI"
# Chave compartilhada usada para assinar (HMAC-SHA256) as chamadas SaaS -> bot.
# Precisa ser exatamente a mesma no ambiente do bot.
DISCORD_BOT_SHARED_SECRET="COLE_O_VALOR_AQUI"
